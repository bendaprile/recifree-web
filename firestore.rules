rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Recipes: public read, authenticated admin-only writes, delete explicitly disabled
    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // Ratings and reviews. Public to read; one per account per recipe, because
    // the uid is the document id and a second review overwrites the first
    // rather than stacking.
    //
    // Display only at this phase. Nothing written here changes what any reader
    // is shown — no ranking, no ordering, no badge — which is what makes a
    // sockpuppet account worthless and lets reviews ship before moderation
    // does. See ROADMAP.md Phase 4a.
    match /reviews/{slug}/entries/{uid} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['rating', 'text', 'authorName', 'createdAt', 'updatedAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        // Pinned to the name the identity provider issued, so a review cannot
        // be signed with someone else's.
        && request.resource.data.authorName == request.auth.token.get('name', null);

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // The explore grid reads every recipe's rating in one collection-group
    // query rather than one query per card. Reviews are already world-readable
    // through the rule above; this changes nothing about who can see what.
    //
    // ⛔ It does claim the name: any collection called `entries`, anywhere in
    // this database, is world-readable from now on. Do not use that name for
    // anything private. Writes are not granted here — they stay with the
    // specific rule above, which checks the uid in the path.
    match /{path=**}/entries/{uid} {
      allow read: if true;
    }

    // User-specific data (Custom Lists and Saved Recipes)
    // Only the authenticated owner can access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /savedRecipes/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // The private shelf: recipes a user extracted but has not published.
      // Owner-only. Nothing here is readable by another account.
      match /shelf/{recipeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

